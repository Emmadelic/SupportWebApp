@page "/create-support"
@rendermode InteractiveServer
@using SupportWebApp.Models
@using SupportWebApp.Services
@inject CosmosDbService CosmosDbService

<PageTitle>Opret supporthenvendelse</PageTitle>

<h1>Opret supporthenvendelse</h1>

<EditForm Model="@message" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label for="name">Navn</label>
        <InputText id="name" @bind-Value="message.Name" />
        <ValidationMessage For="() => message.Name" />
    </div>

    <div>
        <label for="email">E-mail</label>
        <InputText id="email" type="email" @bind-Value="message.Email" />
        <ValidationMessage For="() => message.Email" />
    </div>

    <div>
        <label for="phone">Telefonnummer</label>
        <InputText id="phone" @bind-Value="message.Phone" />
        <ValidationMessage For="() => message.Phone" />
    </div>

    <div>
        <label for="category">Kategori</label>
        <InputSelect id="category" @bind-Value="message.Category">
            <option value="">Vælg kategori</option>
            <option value="Teknisk problem">Teknisk problem</option>
            <option value="Faktura">Faktura</option>
            <option value="Andet">Andet</option>
        </InputSelect>
        <ValidationMessage For="() => message.Category" />
    </div>

    <div>
        <label for="description">Beskrivelse</label>
        <InputTextArea id="description" @bind-Value="message.Description" />
        <ValidationMessage For="() => message.Description" />
    </div>

    <button type="submit">Opret henvendelse</button>
</EditForm>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <p>@statusMessage</p>
}

@code {
    private SupportMessage message = new();
    private string statusMessage = string.Empty;

    private async Task HandleValidSubmit()
    {
        try
        {
            await CosmosDbService.AddAsync(message);
            statusMessage = "Din supporthenvendelse er oprettet.";
            message = new SupportMessage();
        }
        catch (Exception)
        {
            statusMessage = "Henvendelsen kunne ikke oprettes.";
        }
    }
}